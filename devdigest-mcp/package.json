{
  "name": "@devdigest/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local DevDigest MCP server (stdio) — thin HTTP wrapper around the running API on :3001.",
  "bin": {
    "devdigest-mcp": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
